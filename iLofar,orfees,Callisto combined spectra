def plot_combined_spectrum(time_grid_dt, freqs, data, time_range_iso, title):
    fig, ax = plt.subplots(figsize=(8, 4))
    tnum = date2num(time_grid_dt)
    vmin, vmax = np.nanpercentile(data, [1, 99])
    pcm = ax.pcolormesh(tnum, freqs, data.T, shading='auto', cmap='inferno',
                        vmin=vmin, vmax=vmax)
    ax.set_ylabel('Frequency (MHz)')
    ax.set_xlabel('Time (UT, 2024-11-06)')
    ax.set_title(title)
    ax.xaxis_date()
    ax.xaxis.set_major_formatter(DateFormatter('%H:%M:%S'))
    t_start = Time(time_range_iso[0], format='isot').to_datetime()
    t_end   = Time(time_range_iso[1], format='isot').to_datetime()
    ax.set_xlim(date2num(t_start), date2num(t_end))
    ax.set_ylim(freqs.min(), freqs.max())
    #cbar = fig.colorbar(pcm, ax=ax, label="Normalized intensity")
    fig.autofmt_xdate()
    plt.tight_layout()
   # ax.set_yscale('log')
   # Optional: log y-axis
    ax.set_yscale('log')
    ax.yaxis.set_major_locator(LogLocator(base=10.0, subs=[200, 300, 400, 500, 600, 700], numticks=15))
    ax.yaxis.set_major_formatter(ScalarFormatter()) # show numbers instead of scientific notation
    ax.yaxis.set_minor_formatter(ScalarFormatter())
    ax.ticklabel_format(style='plain', axis='y') 
    plt.savefig('combined_dynamic_spectrum_with_lofar.png', dpi=300, bbox_inches='tight')
    # Add cursor that follows mouse
    cursor = Cursor(ax, horizOn=True, vertOn=True, color='red', linewidth=1)
    plt.show()

   
def plot_time_profiles(time_grid_dt, freqs_combined, data_combined, time_range, chosen_freqs):
    plt.figure(figsize=(10, 4))
    for f in chosen_freqs:
        idx = np.argmin(np.abs(freqs_combined - f))
        plt.plot(time_grid_dt, data_combined[:, idx], label=f"{freqs_combined[idx]:.0f} MHz")
    plt.xlabel("Time [UT]")
    plt.ylabel("Intensity")
    plt.title("Time Profiles at Selected Frequencies")
    plt.legend()
    plt.gca().xaxis.set_major_formatter(mdates.DateFormatter('%H:%M:%S'))
    t_start = Time(time_range[0], format='isot').to_datetime()
    t_end   = Time(time_range[1], format='isot').to_datetime()
    plt.xlim(t_start, t_end)
    plt.tight_layout()
    plt.show()

